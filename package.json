{
  "name": "edit-zap-js",
  "version": "0.1.1",
  "description": "Extensible WhatsApp message editor with a headless TypeScript core",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./web": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/declarations.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "build:playground": "vite build --config vite.playground.config.ts"
  },
  "dependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "dompurify": "^3.2.0",
    "@tiptap/pm": "^3.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.15.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juancjc/edit-zap-js.git"
  },
  "homepage": "https://github.com/Juancjc/edit-zap-js#readme",
  "bugs": {
    "url": "https://github.com/Juancjc/edit-zap-js/issues"
  },
  "keywords": [
    "whatsapp",
    "editor",
    "wysiwyg",
    "rich-text",
    "tiptap",
    "typescript",
    "vue",
    "react",
    "templates"
  ]
}
